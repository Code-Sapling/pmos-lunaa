# Reference: <https://postmarketos.org/devicepkg>
maintainer="Abdullah AL-Swedi <abdullahfanar7@gmail.com>"
pkgname=device-realme-lunaa
pkgver=1
pkgrel=7
pkgdesc="Realme GT Master Edition"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
	android-tools-mkbootimg
	firmware-realme-lunaa
	mesa-vulkan-freedreno
	linux-realme-lunaa
	postmarketos-base
	postmarketos-base-downstream
	"
makedepends="devicepkg-dev"
subpackages="$pkgname-sxmo:sxmo"
source="
	deviceinfo
	modules-initfs
	lunaa-yupik.dtb
	sxmo_deviceprofile.sh
	10-wlr-renderer.sh
	lunaa-wifi-up.sh
	lunaa-wifi.initd
	90-lunaa-gpu.rules
	"
install="$pkgname.post-install $pkgname.post-upgrade"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# LineageOS' stock multi-DTB blob, extracted verbatim from the stock
	# vendor_boot.img. boot-deploy's find_dtb() looks in /boot/dtbs*/.
	install -Dm644 "$srcdir"/lunaa-yupik.dtb \
		"$pkgdir"/boot/dtbs/lunaa-yupik.dtb

	# Renderer for wlroots compositors. A hardware fact, not a UI preference,
	# so it stays in the main package and applies to sway, phosh/phoc and
	# anything else wlroots-based; mutter ignores it. See the file's header --
	# it requires the local mesa aport.
	install -Dm644 "$srcdir"/10-wlr-renderer.sh \
		"$pkgdir"/usr/share/tinydm/env-wayland.d/10-wlr-renderer.sh

	# WCN6750 wifi needs three manual steps at boot -- see the script.
	install -Dm755 "$srcdir"/lunaa-wifi-up.sh "$pkgdir"/usr/bin/lunaa-wifi-up.sh
	install -Dm755 "$srcdir"/lunaa-wifi.initd "$pkgdir"/etc/init.d/lunaa-wifi

	# /dev/kgsl-3d0 and /dev/ion are root:root 0600 by default, which makes
	# Vulkan root-only. Not a UI preference -- a property of this hardware.
	install -Dm644 "$srcdir"/90-lunaa-gpu.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-lunaa-gpu.rules
}

sxmo() {
	# UI-specific config, kept out of the main package: only meaningful with
	# sxmo installed, and dead weight under phosh/plasma. The pixman renderer
	# setting stays in the main package -- that one is a hardware fact (no
	# working GL on this device), not a UI preference.
	pkgdesc="$pkgdesc (sxmo configuration)"
	depends=""
	# abuild forbids "," in source filenames, so it ships under a plain name
	# and is installed to the path sxmo looks for (the device-tree
	# compatible, commas and all).
	install -Dm755 "$srcdir"/sxmo_deviceprofile.sh \
		"$subpkgdir/usr/bin/sxmo_deviceprofile_qcom,yupik-idp.sh"
}

