#!/bin/sh
# NOTE: apk runs this only on a *fresh* install. On an upgrade it runs
# .post-upgrade instead, which is why that file exists and is identical --
# without it, anyone who already had an older revision installed never got
# the service enabled and wifi silently did not come up at boot.
rc-update add lunaa-wifi default
rc-update add lunaa-adsp default
exit 0
