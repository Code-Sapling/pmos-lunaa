# Generated boot images
out/

# Extracted ROM images (~2.2GB) and the staged firmware tree.
# Both are rebuilt by tools/extract-firmware.sh from a stock LineageOS zip.
blobs/extract/
blobs/fwstage/

# Proprietary Qualcomm firmware. NOT redistributable -- build your own with
# tools/extract-firmware.sh <lineage-20.0-*-lunaa.zip>.
blobs/*.tar.gz

# blobs/lunaa-yupik.dtb IS tracked: it is compiled from the kernel's DTS, so
# it is GPL-2.0 like its source (pinned commit in aports/linux-realme-lunaa),
# and LineageOS already ships it publicly. Tracking it saves everyone the same
# extraction. The firmware tarball above is NOT tracked and must not be.

# Compiled init shim -- tools/build-images.sh rebuilds it from finalinit.c
# whenever it is missing or stale.
tools/finalinit
